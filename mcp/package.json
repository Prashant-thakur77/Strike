{
  "name": "@strike/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents quote, propose and monitor Strike options vaults",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "strike-source": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./http": {
      "strike-source": "./src/http.ts",
      "import": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "strike-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/http.ts --format esm --clean",
    "dev": "tsx --conditions=strike-source src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@strike/sdk": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
