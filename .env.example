# Variables for docker-compose.yml (copy to .env, which is gitignored) and for running the services directly.
# Names only: fill in your own values in .env and never commit it. Empty means the default in brackets.

# --- Postgres (compose builds the indexer's DATABASE_URL from these; use URL-safe characters) ---
# [strike]
POSTGRES_USER=
# required by docker compose
POSTGRES_PASSWORD=
# [strike]
POSTGRES_DB=

# --- RPC (optional; without them the chains' public RPCs) ---
# Alchemy for every chain, the key sent in a header (sdk/src/rpc.ts)
ALCHEMY_API_KEY=
# Per-chain RPC for the indexer (Robinhood Chain testnet, Arbitrum Sepolia)
RPC_URL_46630=
RPC_URL_421614=

# --- Indexer (services/indexer/README.md) ---
# Running it outside compose: the Postgres connection string
DATABASE_URL=
# Host port of the API [8787]
INDEXER_PORT=
# Chain ids to index, comma-separated [every chain in strike.config.json or contracts/deployments]
INDEXER_CHAINS=
# Blocks behind the head that are indexed [5]
CONFIRMATIONS=
# Seconds between passes [10]
POLL_INTERVAL_SECONDS=
# Largest getLogs range, halved when an RPC refuses it [500000]
LOG_MAX_RANGE=
# /ready fails beyond this lag in blocks [1000] or this head age in seconds [300]
READY_MAX_LAG_BLOCKS=
READY_MAX_HEAD_AGE_SECONDS=
# Seconds between vault value reads, 0 to turn them off [300]
TVL_INTERVAL_SECONDS=
# Seconds a SIGTERM waits for the chunk in flight [25]
SHUTDOWN_TIMEOUT_SECONDS=
# Postgres connections for the API [10]
PGPOOL_MAX=
# trace, debug, info, warn, error [info]
LOG_LEVEL=
# Outside Docker: the repository root and the config file [found from the working directory]
STRIKE_ROOT=
STRIKE_CONFIG=

# --- Telegram bot (docker compose --profile bot; bots/telegram/README.md) ---
# From @BotFather; required to start the bot
TELEGRAM_BOT_TOKEN=
# [46630]
STRIKE_CHAIN_ID=
STRIKE_RPC_URL=
# Seconds between log polls [15]
BOT_POLL_INTERVAL_SECONDS=
# [50000]
LOG_BLOCK_RANGE=
# [https://api.telegram.org]
TELEGRAM_API_URL=
