{
  "name": "@strike/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for Strike options vaults on Robinhood Chain and Arbitrum",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "strike-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
