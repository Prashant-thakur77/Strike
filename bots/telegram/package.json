{
  "name": "@strike/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Telegram bot: Strike vault alerts from on-chain logs, plus vault, quote, agent and status commands",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx --conditions=strike-source src/index.ts",
    "dry-run": "tsx --conditions=strike-source src/dry-run.ts",
    "build": "tsup src/index.ts src/dry-run.ts --format esm --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@strike/sdk": "workspace:*",
    "tsx": "^4.23.15",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
