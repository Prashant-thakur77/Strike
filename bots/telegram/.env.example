# Telegram bot token from @BotFather. Without it, only `pnpm dry-run` works.
TELEGRAM_BOT_TOKEN=
# Strike chain: 46630 = Robinhood Chain testnet (default; v2, or v3 through the STRIKE_* address overrides in this folder's README.md),
# 421614 = Arbitrum Sepolia (v3), 31337 = local devnet. 4663 (mainnet) has no deployment yet.
STRIKE_CHAIN_ID=46630
# Optional: your own RPC endpoint (default: the chain's public RPC).
STRIKE_RPC_URL=
# Where subscribers and the log cursor are stored (a JSON file per chain).
DATA_DIR=./data
# Optional tuning.
# POLL_INTERVAL_SECONDS=15
# LOG_BLOCK_RANGE=50000
# TELEGRAM_API_URL=https://api.telegram.org
