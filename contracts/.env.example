# Copy to contracts/.env (gitignored). Only needed for deploy scripts and fork tests.
# With an Alchemy key, the same chains are https://robinhood-mainnet.g.alchemy.com/v2/<key>, robinhood-testnet and
# arb-sepolia (scripts/rpc.sh builds them from ALCHEMY_API_KEY).
PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
ARBISCAN_API_KEY=
